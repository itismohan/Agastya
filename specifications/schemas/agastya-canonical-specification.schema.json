{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agastya.dev/schemas/canonical-specification/1.0.0/schema.json",
  "title": "AGASTYA Canonical Specification",
  "description": "The authoritative, versioned representation of engineering intent for AGASTYA. This schema validates the state of one immutable specification revision.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schema_version",
    "id",
    "version",
    "status",
    "title",
    "project",
    "intent",
    "problem",
    "business_context",
    "stakeholders",
    "actors",
    "functional_requirements",
    "non_functional_requirements",
    "business_rules",
    "constraints",
    "assumptions",
    "dependencies",
    "domain_model",
    "entities",
    "workflows",
    "state_models",
    "api_contracts",
    "event_contracts",
    "data_models",
    "security_requirements",
    "compliance_requirements",
    "performance_requirements",
    "accessibility_requirements",
    "observability_requirements",
    "acceptance_criteria",
    "test_requirements",
    "deployment_requirements",
    "risks",
    "open_questions",
    "architecture_decisions",
    "traceability",
    "evidence",
    "change_history",
    "approvals",
    "metadata"
  ],
  "properties": {
    "$schema": {
      "type": "string",
      "const": "https://agastya.dev/schemas/canonical-specification/1.0.0/schema.json"
    },
    "schema_version": {
      "$ref": "#/$defs/semver",
      "description": "Version of the canonical AGASTYA schema used to validate this revision."
    },
    "id": {
      "$ref": "#/$defs/specificationId"
    },
    "version": {
      "$ref": "#/$defs/semver",
      "description": "Immutable business version of this specification revision."
    },
    "status": {
      "type": "string",
      "enum": [
        "DRAFT",
        "ANALYSING",
        "PROPOSED",
        "VALIDATING",
        "APPROVED",
        "IMPLEMENTING",
        "VERIFYING",
        "ACTIVE",
        "CURATING",
        "SUPERSEDED",
        "ARCHIVED"
      ]
    },
    "title": {
      "type": "string",
      "minLength": 8,
      "maxLength": 160
    },
    "summary": {
      "type": "string",
      "minLength": 20,
      "maxLength": 1000
    },
    "project": {
      "$ref": "#/$defs/project"
    },
    "intent": {
      "$ref": "#/$defs/intent"
    },
    "problem": {
      "$ref": "#/$defs/problem"
    },
    "business_context": {
      "$ref": "#/$defs/businessContext"
    },
    "stakeholders": {
      "type": "array",
      "items": { "$ref": "#/$defs/stakeholder" },
      "uniqueItems": true
    },
    "actors": {
      "type": "array",
      "items": { "$ref": "#/$defs/actor" },
      "uniqueItems": true
    },
    "functional_requirements": {
      "type": "array",
      "items": { "$ref": "#/$defs/functionalRequirement" },
      "uniqueItems": true
    },
    "non_functional_requirements": {
      "type": "array",
      "items": { "$ref": "#/$defs/nonFunctionalRequirement" },
      "uniqueItems": true
    },
    "business_rules": {
      "type": "array",
      "items": { "$ref": "#/$defs/businessRule" },
      "uniqueItems": true
    },
    "constraints": {
      "type": "array",
      "items": { "$ref": "#/$defs/constraint" },
      "uniqueItems": true
    },
    "assumptions": {
      "type": "array",
      "items": { "$ref": "#/$defs/assumption" },
      "uniqueItems": true
    },
    "dependencies": {
      "type": "array",
      "items": { "$ref": "#/$defs/dependency" },
      "uniqueItems": true
    },
    "domain_model": {
      "$ref": "#/$defs/domainModel"
    },
    "entities": {
      "type": "array",
      "items": { "$ref": "#/$defs/entity" },
      "uniqueItems": true
    },
    "workflows": {
      "type": "array",
      "items": { "$ref": "#/$defs/workflow" },
      "uniqueItems": true
    },
    "state_models": {
      "type": "array",
      "items": { "$ref": "#/$defs/stateModel" },
      "uniqueItems": true
    },
    "api_contracts": {
      "type": "array",
      "items": { "$ref": "#/$defs/apiContract" },
      "uniqueItems": true
    },
    "event_contracts": {
      "type": "array",
      "items": { "$ref": "#/$defs/eventContract" },
      "uniqueItems": true
    },
    "data_models": {
      "type": "array",
      "items": { "$ref": "#/$defs/dataModel" },
      "uniqueItems": true
    },
    "security_requirements": {
      "type": "array",
      "items": { "$ref": "#/$defs/qualityRequirement" },
      "uniqueItems": true
    },
    "compliance_requirements": {
      "type": "array",
      "items": { "$ref": "#/$defs/qualityRequirement" },
      "uniqueItems": true
    },
    "performance_requirements": {
      "type": "array",
      "items": { "$ref": "#/$defs/performanceRequirement" },
      "uniqueItems": true
    },
    "accessibility_requirements": {
      "type": "array",
      "items": { "$ref": "#/$defs/qualityRequirement" },
      "uniqueItems": true
    },
    "observability_requirements": {
      "type": "array",
      "items": { "$ref": "#/$defs/qualityRequirement" },
      "uniqueItems": true
    },
    "acceptance_criteria": {
      "type": "array",
      "items": { "$ref": "#/$defs/acceptanceCriterion" },
      "uniqueItems": true
    },
    "test_requirements": {
      "type": "array",
      "items": { "$ref": "#/$defs/testRequirement" },
      "uniqueItems": true
    },
    "deployment_requirements": {
      "type": "array",
      "items": { "$ref": "#/$defs/deploymentRequirement" },
      "uniqueItems": true
    },
    "risks": {
      "type": "array",
      "items": { "$ref": "#/$defs/risk" },
      "uniqueItems": true
    },
    "open_questions": {
      "type": "array",
      "items": { "$ref": "#/$defs/openQuestion" },
      "uniqueItems": true
    },
    "architecture_decisions": {
      "type": "array",
      "items": { "$ref": "#/$defs/architectureDecision" },
      "uniqueItems": true
    },
    "traceability": {
      "$ref": "#/$defs/traceability"
    },
    "evidence": {
      "type": "array",
      "items": { "$ref": "#/$defs/evidence" },
      "uniqueItems": true
    },
    "change_history": {
      "type": "array",
      "items": { "$ref": "#/$defs/changeHistoryEntry" },
      "uniqueItems": true
    },
    "approvals": {
      "type": "array",
      "items": { "$ref": "#/$defs/approval" },
      "uniqueItems": true
    },
    "metadata": {
      "$ref": "#/$defs/metadata"
    },
    "extensions": {
      "type": "object",
      "description": "Namespaced extension data. Extensions must not redefine core fields.",
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9-]*(\\.[a-z][a-z0-9-]*)+$"
      },
      "additionalProperties": true
    }
  },
  "allOf": [
    {
      "if": {
        "properties": { "status": { "const": "APPROVED" } },
        "required": ["status"]
      },
      "then": {
        "properties": {
          "approvals": {
            "contains": {
              "type": "object",
              "properties": { "decision": { "const": "APPROVED" } },
              "required": ["decision"]
            }
          },
          "open_questions": {
            "not": {
              "contains": {
                "type": "object",
                "properties": { "status": { "const": "OPEN" } },
                "required": ["status"]
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": { "status": { "enum": ["IMPLEMENTING", "VERIFYING", "ACTIVE", "CURATING"] } },
        "required": ["status"]
      },
      "then": {
        "properties": {
          "approvals": {
            "contains": {
              "type": "object",
              "properties": { "decision": { "const": "APPROVED" } },
              "required": ["decision"]
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "semver": {
      "type": "string",
      "pattern": "^0|[1-9][0-9]*\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$"
    },
    "specificationId": {
      "type": "string",
      "pattern": "^SPEC-[A-Z0-9][A-Z0-9-]{2,62}$",
      "examples": ["SPEC-PLATFORM-001"]
    },
    "artifactId": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9_]*-[A-Z0-9][A-Z0-9-]{1,62}$"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "actorReference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "display_name", "type"],
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 160 },
        "display_name": { "type": "string", "minLength": 1, "maxLength": 160 },
        "type": { "type": "string", "enum": ["HUMAN", "SERVICE", "AGENT"] }
      }
    },
    "artifactReference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind"],
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 160 },
        "kind": {
          "type": "string",
          "enum": [
            "INTENT", "REQUIREMENT", "BUSINESS_RULE", "CONSTRAINT", "ASSUMPTION", "ENTITY",
            "WORKFLOW", "STATE_MODEL", "API_CONTRACT", "EVENT_CONTRACT", "DATA_MODEL",
            "ARCHITECTURE_DECISION", "TEST_REQUIREMENT", "TEST", "CODE", "COMPONENT",
            "DEPLOYMENT", "EVIDENCE", "RISK", "POLICY", "DOCUMENT", "SPECIFICATION"
          ]
        },
        "version": { "$ref": "#/$defs/semver" },
        "uri": { "type": "string", "format": "uri" },
        "label": { "type": "string", "maxLength": 240 }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_type", "recorded_at", "recorded_by", "confidence"],
      "properties": {
        "source_type": {
          "type": "string",
          "enum": ["HUMAN", "IMPORT", "REPOSITORY_ANALYSIS", "TEST_RUN", "RUNTIME", "AGENT", "INTEGRATION"]
        },
        "source_uri": { "type": "string", "format": "uri" },
        "recorded_at": { "$ref": "#/$defs/timestamp" },
        "recorded_by": { "$ref": "#/$defs/actorReference" },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "rationale": { "type": "string", "maxLength": 2000 }
      }
    },
    "project": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "tenant_id"],
      "properties": {
        "id": { "type": "string", "pattern": "^PRJ-[A-Z0-9][A-Z0-9-]{2,62}$" },
        "name": { "type": "string", "minLength": 2, "maxLength": 160 },
        "tenant_id": { "type": "string", "minLength": 2, "maxLength": 160 },
        "repository_refs": {
          "type": "array",
          "items": { "type": "string", "format": "uri" },
          "uniqueItems": true
        },
        "environment": { "type": "string", "enum": ["LOCAL", "DEVELOPMENT", "TEST", "STAGING", "PRODUCTION"] }
      }
    },
    "intent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "statement", "desired_outcomes", "success_measures", "provenance"],
      "properties": {
        "id": { "$ref": "#/$defs/artifactId" },
        "statement": { "type": "string", "minLength": 20, "maxLength": 4000 },
        "desired_outcomes": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 8, "maxLength": 1000 } },
        "success_measures": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/measure" } },
        "out_of_scope": { "type": "array", "items": { "type": "string", "minLength": 4, "maxLength": 1000 } },
        "provenance": { "$ref": "#/$defs/provenance" }
      }
    },
    "measure": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "target", "measurement_method"],
      "properties": {
        "name": { "type": "string", "minLength": 3, "maxLength": 160 },
        "target": { "type": "string", "minLength": 1, "maxLength": 160 },
        "measurement_method": { "type": "string", "minLength": 8, "maxLength": 1000 },
        "baseline": { "type": "string", "maxLength": 160 }
      }
    },
    "problem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["statement", "current_state", "impact", "evidence"],
      "properties": {
        "statement": { "type": "string", "minLength": 20, "maxLength": 4000 },
        "current_state": { "type": "string", "minLength": 20, "maxLength": 6000 },
        "impact": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 8, "maxLength": 1000 } },
        "evidence": { "type": "array", "items": { "$ref": "#/$defs/artifactReference" } }
      }
    },
    "businessContext": {
      "type": "object",
      "additionalProperties": false,
      "required": ["domain", "business_value", "priority"],
      "properties": {
        "domain": { "type": "string", "minLength": 2, "maxLength": 160 },
        "business_value": { "type": "string", "minLength": 20, "maxLength": 4000 },
        "priority": { "type": "string", "enum": ["CRITICAL", "HIGH", "MEDIUM", "LOW"] },
        "target_users": { "type": "array", "items": { "type": "string", "minLength": 2, "maxLength": 160 } },
        "deadline": { "type": "string", "format": "date" }
      }
    },
    "stakeholder": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "role", "interests"],
      "properties": {
        "id": { "$ref": "#/$defs/artifactId" },
        "name": { "type": "string", "minLength": 2, "maxLength": 160 },
        "role": { "type": "string", "minLength": 2, "maxLength": 160 },
        "interests": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 4, "maxLength": 500 } },
        "influence": { "type": "string", "enum": ["HIGH", "MEDIUM", "LOW"] }
      }
    },
    "actor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "type", "goals"],
      "properties": {
        "id": { "$ref": "#/$defs/artifactId" },
        "name": { "type": "string", "minLength": 2, "maxLength": 160 },
        "type": { "type": "string", "enum": ["HUMAN", "SYSTEM", "AGENT", "EXTERNAL_SERVICE"] },
        "goals": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 4, "maxLength": 500 } },
        "permissions": { "type": "array", "items": { "type": "string", "minLength": 3, "maxLength": 160 } }
      }
    },
    "functionalRequirement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "statement", "priority", "status", "acceptance_criteria_refs", "provenance"],
      "properties": {
        "id": { "$ref": "#/$defs/artifactId" },
        "title": { "type": "string", "minLength": 8, "maxLength": 240 },
        "statement": { "type": "string", "minLength": 20, "maxLength": 4000 },
        "rationale": { "type": "string", "maxLength": 2000 },
        "priority": { "type": "string", "enum": ["MUST", "SHOULD", "COULD", "WONT"] },
        "status": { "type": "string", "enum": ["PROPOSED", "APPROVED", "IMPLEMENTED", "VERIFIED", "BLOCKED", "SUPERSEDED"] },
        "acceptance_criteria_refs": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/artifactId" }, "uniqueItems": true },
        "business_rule_refs": { "type": "array", "items": { "$ref": "#/$defs/artifactId" }, "uniqueItems": true },
        "dependency_refs": { "type": "array", "items": { "$ref": "#/$defs/artifactId" }, "uniqueItems": true },
        "risk_refs": { "type": "array", "items": { "$ref": "#/$defs/artifactId" }, "uniqueItems": true },
        "provenance": { "$ref": "#/$defs/provenance" }
      }
    },
    "nonFunctionalRequirement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "category", "statement", "priority", "verification_method", "provenance"],
      "properties": {
        "id": { "$ref": "#/$defs/artifactId" },
        "category": { "type": "string", "enum": ["SECURITY", "PERFORMANCE", "RELIABILITY", "ACCESSIBILITY", "OBSERVABILITY", "SCALABILITY", "MAINTAINABILITY", "PRIVACY", "USABILITY"] },
        "statement": { "type": "string", "minLength": 20, "maxLength": 4000 },
        "priority": { "type": "string", "enum": ["MUST", "SHOULD", "COULD", "WONT"] },
        "verification_method": { "type": "string", "minLength": 8, "maxLength": 1600 },
        "target": { "type": "string", "maxLength": 500 },
        "provenance": { "$ref": "#/$defs/provenance" }
      }
    },
    "businessRule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "statement", "enforcement", "provenance"],
      "properties": {
        "id": { "$ref": "#/$defs/artifactId" },
        "statement": { "type": "string", "minLength": 12, "maxLength": 4000 },
        "enforcement": { "type": "string", "enum": ["SYSTEM", "HUMAN_APPROVAL", "POLICY", "TEST", "MANUAL"] },
        "exceptions": { "type": "array", "items": { "type": "string", "minLength": 4, "maxLength": 1000 } },
        "provenance": { "$ref": "#/$defs/provenance" }
      }
    },
    "constraint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "statement", "rationale"],
      "properties": {
        "id": { "$ref": "#/$defs/artifactId" },
        "type": { "type": "string", "enum": ["TECHNICAL", "BUSINESS", "LEGAL", "SECURITY", "TIME", "BUDGET", "INTEGRATION", "OPERATIONAL"] },
        "statement": { "type": "string", "minLength": 12, "maxLength": 3000 },
        "rationale": { "type": "string", "minLength": 8, "maxLength": 2000 },
        "enforced_by": { "type": "array", "items": { "$ref": "#/$defs/artifactId" }, "uniqueItems": true }
      }
    },
    "assumption": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "statement", "status", "risk_if_false", "owner"],
      "properties": {
        "id": { "$ref": "#/$defs/artifactId" },
        "statement": { "type": "string", "minLength": 12, "maxLength": 3000 },
        "status": { "type": "string", "enum": ["UNVALIDATED", "VALIDATED", "INVALIDATED"] },
        "risk_if_false": { "type": "string", "minLength": 8, "maxLength": 1600 },
        "owner": { "$ref": "#/$defs/actorReference" },
        "validation_evidence_refs": { "type": "array", "items": { "$ref": "#/$defs/artifactId" }, "uniqueItems": true }
      }
    },
    "dependency": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "type", "status", "owner"],
      "properties": {
        "id": { "$ref": "#/$defs/artifactId" },
        "name": { "type": "string", "minLength": 2, "maxLength": 240 },
        "type": { "type": "string", "enum": ["INTERNAL_SERVICE", "EXTERNAL_SERVICE", "LIBRARY", "TEAM", "DATA", "INFRASTRUCTURE", "POLICY"] },
        "status": { "type": "string", "enum": ["AVAILABLE", "AT_RISK", "BLOCKED", "UNKNOWN"] },
        "owner": { "$ref": "#/$defs/actorReference" },
        "interface_ref": { "$ref": "#/$defs/artifactReference" },
        "risk": { "type": "string", "maxLength": 1600 }
      }
    },
    "domainModel": {
      "type": "object",
      "additionalProperties": false,
      "required": ["bounded_contexts", "ubiquitous_language"],
      "properties": {
        "bounded_contexts": { "type": "array", "items": { "$ref": "#/$defs/boundedContext" }, "uniqueItems": true },
        "ubiquitous_language": { "type": "array", "items": { "$ref": "#/$defs/glossaryTerm" }, "uniqueItems": true }
      }
    },
    "boundedContext": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "responsibility"],
      "properties": {
        "id": { "$ref": "#/$defs/artifactId" },
        "name": { "type": "string", "minLength": 2, "maxLength": 160 },
        "responsibility": { "type": "string", "minLength": 8, "maxLength": 1600 },
        "upstream_context_refs": { "type": "array", "items": { "$ref": "#/$defs/artifactId" }, "uniqueItems": true },
        "downstream_context_refs": { "type": "array", "items": { "$ref": "#/$defs/artifactId" }, "uniqueItems": true }
      }
    },
    "glossaryTerm": {
      "type": "object",
      "additionalProperties": false,
      "required": ["term", "definition"],
      "properties": {
        "term": { "type": "string", "minLength": 2, "maxLength": 120 },
        "definition": { "type": "string", "minLength": 8, "maxLength": 1000 }
      }
    },
    "entity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "description", "attributes"],
      "properties": {
        "id": { "$ref": "#/$defs/artifactId" },
        "name": { "type": "string", "minLength": 2, "maxLength": 160 },
        "description": { "type": "string", "minLength": 8, "maxLength": 1600 },
        "attributes": { "type": "array", "items": { "$ref": "#/$defs/entityAttribute" }, "uniqueItems": true },
        "invariants": { "type": "array", "items": { "$ref": "#/$defs/artifactId" }, "uniqueItems": true }
      }
    },
    "entityAttribute": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "type", "required"],
      "properties": {
        "name": { "type": "string", "pattern": "^[a-z][A-Za-z0-9_]{0,62}$" },
        "type": { "type": "string", "minLength": 1, "maxLength": 160 },
        "required": { "type": "boolean" },
        "description": { "type": "string", "maxLength": 1000 },
        "classification": { "type": "string", "enum": ["PUBLIC", "INTERNAL", "CONFIDENTIAL", "RESTRICTED"] }
      }
    },
    "workflow": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "trigger", "steps", "outcomes"],
      "properties": {
        "id": { "$ref": "#/$defs/artifactId" },
        "name": { "type": "string", "minLength": 4, "maxLength": 240 },
        "trigger": { "type": "string", "minLength": 4, "maxLength": 1000 },
        "steps": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/workflowStep" } },
        "outcomes": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 4, "maxLength": 1000 } },
        "error_handling": { "type": "string", "maxLength": 2000 }
      }
    },
    "workflowStep": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sequence", "actor_ref", "action", "result"],
      "properties": {
        "sequence": { "type": "integer", "minimum": 1 },
        "actor_ref": { "$ref": "#/$defs/artifactId" },
        "action": { "type": "string", "minLength": 4, "maxLength": 1000 },
        "result": { "type": "string", "minLength": 4, "maxLength": 1000 },
        "rule_refs": { "type": "array", "items": { "$ref": "#/$defs/artifactId" }, "uniqueItems": true }
      }
    },
    "stateModel": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "initial_state", "states", "transitions"],
      "properties": {
        "id": { "$ref": "#/$defs/artifactId" },
        "name": { "type": "string", "minLength": 4, "maxLength": 240 },
        "initial_state": { "type": "string", "minLength": 1, "maxLength": 120 },
        "states": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/state" }, "uniqueItems": true },
        "transitions": { "type": "array", "items": { "$ref": "#/$defs/stateTransition" } }
      }
    },
    "state": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "terminal"],
      "properties": {
        "name": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]{0,62}$" },
        "terminal": { "type": "boolean" },
        "description": { "type": "string", "maxLength": 1000 }
      }
    },
    "stateTransition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["from", "to", "trigger"],
      "properties": {
        "from": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]{0,62}$" },
        "to": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]{0,62}$" },
        "trigger": { "type": "string", "minLength": 2, "maxLength": 240 },
        "guard_rule_refs": { "type": "array", "items": { "$ref": "#/$defs/artifactId" }, "uniqueItems": true }
      }
    },
    "apiContract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "protocol", "source", "version", "operations"],
      "properties": {
        "id": { "$ref": "#/$defs/artifactId" },
        "name": { "type": "string", "minLength": 4, "maxLength": 240 },
        "protocol": { "type": "string", "enum": ["REST", "GRAPHQL", "GRPC", "WEBSOCKET", "INTERNAL"] },
        "source": { "$ref": "#/$defs/contractSource" },
        "version": { "$ref": "#/$defs/semver" },
        "operations": { "type": "array", "items": { "$ref": "#/$defs/apiOperation" }, "uniqueItems": true }
      }
    },
    "contractSource": {
      "type": "object",
      "additionalProperties": false,
      "required": ["format", "uri"],
      "properties": {
        "format": { "type": "string", "enum": ["OPENAPI", "JSON_SCHEMA", "PROTOBUF", "GRAPHQL_SDL", "INLINE"] },
        "uri": { "type": "string", "format": "uri" },
        "checksum": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" }
      }
    },
    "apiOperation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "method", "path", "purpose"],
      "properties": {
        "id": { "$ref": "#/$defs/artifactId" },
        "method": { "type": "string", "enum": ["GET", "POST", "PUT", "PATCH", "DELETE", "HEAD", "OPTIONS", "QUERY", "MUTATION", "SUBSCRIPTION"] },
        "path": { "type": "string", "minLength": 1, "maxLength": 500 },
        "purpose": { "type": "string", "minLength": 8, "maxLength": 1000 },
        "requirement_refs": { "type": "array", "items": { "$ref": "#/$defs/artifactId" }, "uniqueItems": true }
      }
    },
    "eventContract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "version", "source", "producer", "consumers"],
      "properties": {
        "id": { "$ref": "#/$defs/artifactId" },
        "name": { "type": "string", "minLength": 4, "maxLength": 240 },
        "version": { "$ref": "#/$defs/semver" },
        "source": { "$ref": "#/$defs/contractSource" },
        "producer": { "type": "string", "minLength": 2, "maxLength": 160 },
        "consumers": { "type": "array", "items": { "type": "string", "minLength": 2, "maxLength": 160 }, "uniqueItems": true }
      }
    },
    "dataModel": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "storage_classification", "entity_refs"],
      "properties": {
        "id": { "$ref": "#/$defs/artifactId" },
        "name": { "type": "string", "minLength": 2, "maxLength": 160 },
        "storage_classification": { "type": "string", "enum": ["AUTHORITATIVE", "DERIVED", "CACHE", "EPHEMERAL", "ARCHIVE"] },
        "entity_refs": { "type": "array", "items": { "$ref": "#/$defs/artifactId" }, "uniqueItems": true },
        "retention_policy": { "type": "string", "maxLength": 1000 },
        "security_classification": { "type": "string", "enum": ["PUBLIC", "INTERNAL", "CONFIDENTIAL", "RESTRICTED"] }
      }
    },
    "qualityRequirement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "statement", "verification_method", "priority"],
      "properties": {
        "id": { "$ref": "#/$defs/artifactId" },
        "statement": { "type": "string", "minLength": 12, "maxLength": 4000 },
        "verification_method": { "type": "string", "minLength": 8, "maxLength": 1600 },
        "priority": { "type": "string", "enum": ["MUST", "SHOULD", "COULD", "WONT"] },
        "control_refs": { "type": "array", "items": { "$ref": "#/$defs/artifactId" }, "uniqueItems": true }
      }
    },
    "performanceRequirement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "metric", "target", "condition", "verification_method"],
      "properties": {
        "id": { "$ref": "#/$defs/artifactId" },
        "metric": { "type": "string", "enum": ["LATENCY", "THROUGHPUT", "ERROR_RATE", "AVAILABILITY", "RESOURCE_UTILISATION", "QUEUE_DELAY"] },
        "target": { "type": "string", "minLength": 2, "maxLength": 160 },
        "condition": { "type": "string", "minLength": 4, "maxLength": 1000 },
        "verification_method": { "type": "string", "minLength": 8, "maxLength": 1600 }
      }
    },
    "acceptanceCriterion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "requirement_ref", "title", "given", "when", "then", "verification_type"],
      "properties": {
        "id": { "$ref": "#/$defs/artifactId" },
        "requirement_ref": { "$ref": "#/$defs/artifactId" },
        "title": { "type": "string", "minLength": 8, "maxLength": 240 },
        "given": { "type": "string", "minLength": 4, "maxLength": 1600 },
        "when": { "type": "string", "minLength": 4, "maxLength": 1600 },
        "then": { "type": "string", "minLength": 4, "maxLength": 1600 },
        "verification_type": { "type": "string", "enum": ["MANUAL", "AUTOMATED_TEST", "CONTRACT_TEST", "SECURITY_TEST", "PERFORMANCE_TEST", "ACCESSIBILITY_TEST", "REVIEW"] },
        "test_requirement_refs": { "type": "array", "items": { "$ref": "#/$defs/artifactId" }, "uniqueItems": true }
      }
    },
    "testRequirement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "scope", "level", "expected_evidence", "requirement_refs"],
      "properties": {
        "id": { "$ref": "#/$defs/artifactId" },
        "scope": { "type": "string", "minLength": 8, "maxLength": 1600 },
        "level": { "type": "string", "enum": ["UNIT", "INTEGRATION", "CONTRACT", "API", "END_TO_END", "SECURITY", "PERFORMANCE", "ACCESSIBILITY", "REGRESSION", "MANUAL"] },
        "expected_evidence": { "type": "string", "minLength": 8, "maxLength": 1600 },
        "requirement_refs": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/artifactId" }, "uniqueItems": true },
        "acceptance_criteria_refs": { "type": "array", "items": { "$ref": "#/$defs/artifactId" }, "uniqueItems": true }
      }
    },
    "deploymentRequirement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "statement", "environment", "verification_method"],
      "properties": {
        "id": { "$ref": "#/$defs/artifactId" },
        "statement": { "type": "string", "minLength": 12, "maxLength": 3000 },
        "environment": { "type": "string", "enum": ["DEVELOPMENT", "TEST", "STAGING", "PRODUCTION"] },
        "verification_method": { "type": "string", "minLength": 8, "maxLength": 1600 },
        "rollback_requirement": { "type": "string", "maxLength": 1600 }
      }
    },
    "risk": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "description", "severity", "likelihood", "mitigation", "owner", "status"],
      "properties": {
        "id": { "$ref": "#/$defs/artifactId" },
        "title": { "type": "string", "minLength": 8, "maxLength": 240 },
        "description": { "type": "string", "minLength": 12, "maxLength": 3000 },
        "severity": { "type": "string", "enum": ["INFO", "LOW", "MEDIUM", "HIGH", "CRITICAL"] },
        "likelihood": { "type": "string", "enum": ["RARE", "UNLIKELY", "POSSIBLE", "LIKELY", "ALMOST_CERTAIN"] },
        "mitigation": { "type": "string", "minLength": 8, "maxLength": 2000 },
        "owner": { "$ref": "#/$defs/actorReference" },
        "status": { "type": "string", "enum": ["OPEN", "MITIGATED", "ACCEPTED", "CLOSED"] }
      }
    },
    "openQuestion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "question", "status", "owner", "impact_if_unresolved"],
      "properties": {
        "id": { "$ref": "#/$defs/artifactId" },
        "question": { "type": "string", "minLength": 8, "maxLength": 2000 },
        "status": { "type": "string", "enum": ["OPEN", "RESOLVED", "ACCEPTED_RISK", "DEFERRED"] },
        "owner": { "$ref": "#/$defs/actorReference" },
        "impact_if_unresolved": { "type": "string", "minLength": 8, "maxLength": 1600 },
        "resolution": { "type": "string", "maxLength": 2000 },
        "resolved_at": { "$ref": "#/$defs/timestamp" }
      }
    },
    "architectureDecision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "context", "decision", "rationale", "status"],
      "properties": {
        "id": { "type": "string", "pattern": "^ADR-[A-Z0-9][A-Z0-9-]{2,62}$" },
        "title": { "type": "string", "minLength": 8, "maxLength": 240 },
        "context": { "type": "string", "minLength": 12, "maxLength": 4000 },
        "decision": { "type": "string", "minLength": 12, "maxLength": 4000 },
        "alternatives": { "type": "array", "items": { "$ref": "#/$defs/decisionAlternative" }, "uniqueItems": true },
        "rationale": { "type": "string", "minLength": 12, "maxLength": 4000 },
        "consequences": { "type": "array", "items": { "type": "string", "minLength": 4, "maxLength": 1000 } },
        "status": { "type": "string", "enum": ["PROPOSED", "ACCEPTED", "SUPERSEDED", "REJECTED"] },
        "approver_refs": { "type": "array", "items": { "$ref": "#/$defs/actorReference" } }
      }
    },
    "decisionAlternative": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "summary"],
      "properties": {
        "name": { "type": "string", "minLength": 2, "maxLength": 240 },
        "summary": { "type": "string", "minLength": 8, "maxLength": 2000 },
        "rejection_reason": { "type": "string", "maxLength": 2000 }
      }
    },
    "traceability": {
      "type": "object",
      "additionalProperties": false,
      "required": ["links", "coverage_summary"],
      "properties": {
        "links": { "type": "array", "items": { "$ref": "#/$defs/traceLink" }, "uniqueItems": true },
        "coverage_summary": { "$ref": "#/$defs/coverageSummary" }
      }
    },
    "traceLink": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "source", "target", "relationship_type", "confidence", "provenance", "created_at", "updated_at"],
      "properties": {
        "id": { "$ref": "#/$defs/artifactId" },
        "source": { "$ref": "#/$defs/artifactReference" },
        "target": { "$ref": "#/$defs/artifactReference" },
        "relationship_type": { "type": "string", "enum": ["IMPLEMENTS", "SATISFIES", "DEPENDS_ON", "CONSTRAINS", "DERIVED_FROM", "VALIDATES", "VERIFIES", "AFFECTS", "CALLS", "PRODUCES", "CONSUMES", "TRIGGERS", "GOVERNS", "DEPLOYED_AS", "OBSERVED_BY", "DRIFTS_FROM", "SUPERSEDES", "CONTRADICTS"] },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "provenance": { "$ref": "#/$defs/provenance" },
        "created_at": { "$ref": "#/$defs/timestamp" },
        "updated_at": { "$ref": "#/$defs/timestamp" }
      }
    },
    "coverageSummary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["method", "generated_at"],
      "properties": {
        "method": { "type": "string", "minLength": 8, "maxLength": 1000 },
        "generated_at": { "$ref": "#/$defs/timestamp" },
        "requirement_coverage": { "type": "number", "minimum": 0, "maximum": 1 },
        "code_coverage": { "type": "number", "minimum": 0, "maximum": 1 },
        "test_coverage": { "type": "number", "minimum": 0, "maximum": 1 },
        "runtime_coverage": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "status", "summary", "observed_at", "recorded_at", "subject_refs", "provenance"],
      "properties": {
        "id": { "$ref": "#/$defs/artifactId" },
        "type": { "type": "string", "enum": ["TEST_RESULT", "CONTRACT_VALIDATION", "SECURITY_SCAN", "PERFORMANCE_RESULT", "DEPLOYMENT", "LOG", "METRIC", "TRACE", "INCIDENT", "APPROVAL", "MANUAL_REVIEW"] },
        "status": { "type": "string", "enum": ["VERIFIED", "PARTIALLY_VERIFIED", "UNVERIFIED", "FAILED", "STALE", "DRIFTED", "BLOCKED", "SUPERSEDED"] },
        "summary": { "type": "string", "minLength": 8, "maxLength": 4000 },
        "expected_behavior": { "type": "string", "maxLength": 4000 },
        "observed_behavior": { "type": "string", "maxLength": 4000 },
        "observed_at": { "$ref": "#/$defs/timestamp" },
        "recorded_at": { "$ref": "#/$defs/timestamp" },
        "subject_refs": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/artifactReference" }, "uniqueItems": true },
        "implementation_version": { "type": "string", "maxLength": 160 },
        "specification_version": { "$ref": "#/$defs/semver" },
        "artifact_uri": { "type": "string", "format": "uri" },
        "provenance": { "$ref": "#/$defs/provenance" }
      }
    },
    "changeHistoryEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "change_type", "summary", "reason", "author", "created_at"],
      "properties": {
        "id": { "$ref": "#/$defs/artifactId" },
        "version": { "$ref": "#/$defs/semver" },
        "change_type": { "type": "string", "enum": ["CREATED", "UPDATED", "APPROVED", "SUPERSEDED", "ARCHIVED", "MIGRATED"] },
        "summary": { "type": "string", "minLength": 8, "maxLength": 2000 },
        "reason": { "type": "string", "minLength": 8, "maxLength": 2000 },
        "author": { "$ref": "#/$defs/actorReference" },
        "created_at": { "$ref": "#/$defs/timestamp" },
        "previous_version": { "$ref": "#/$defs/semver" },
        "approval_ref": { "$ref": "#/$defs/artifactId" }
      }
    },
    "approval": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "decision", "approver", "policy_ref", "decided_at", "specification_version"],
      "properties": {
        "id": { "$ref": "#/$defs/artifactId" },
        "decision": { "type": "string", "enum": ["APPROVED", "REJECTED", "CHANGES_REQUESTED"] },
        "approver": { "$ref": "#/$defs/actorReference" },
        "policy_ref": { "$ref": "#/$defs/artifactReference" },
        "decided_at": { "$ref": "#/$defs/timestamp" },
        "specification_version": { "$ref": "#/$defs/semver" },
        "reason": { "type": "string", "maxLength": 2000 },
        "evidence_refs": { "type": "array", "items": { "$ref": "#/$defs/artifactId" }, "uniqueItems": true }
      }
    },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["created_at", "created_by", "updated_at", "updated_by", "classification", "language"],
      "properties": {
        "created_at": { "$ref": "#/$defs/timestamp" },
        "created_by": { "$ref": "#/$defs/actorReference" },
        "updated_at": { "$ref": "#/$defs/timestamp" },
        "updated_by": { "$ref": "#/$defs/actorReference" },
        "classification": { "type": "string", "enum": ["PUBLIC", "INTERNAL", "CONFIDENTIAL", "RESTRICTED"] },
        "language": { "type": "string", "pattern": "^[a-z]{2,3}(?:-[A-Z]{2})?$" },
        "tags": { "type": "array", "items": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,62}$" }, "uniqueItems": true }
      }
    }
  }
}
